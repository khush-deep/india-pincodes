{
    "name": "khush/india-pincodes",
    "description": "Offline India PIN code lookup: every post office for a PIN with its type, delivery status, district and state, plus the list of Indian states and union territories.",
    "type": "library",
    "license": "MIT AND LicenseRef-GODL-India",
    "authors": [
        {
            "name": "Khush",
            "email": "khushdeep02@gmail.com"
        }
    ],
    "homepage": "https://github.com/khush-deep/india-pincodes",
    "support": {
        "issues": "https://github.com/khush-deep/india-pincodes/issues"
    },
    "keywords": ["pincode", "pin code", "postal code", "india", "india post", "address"],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Khush\\IndiaPincodes\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Khush\\IndiaPincodes\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
